# Copy this file to .env and fill it in.

# REQUIRED for docker compose: the Chroma server version must match your installed client.
# Find it with:  python -c "import chromadb; print(chromadb.__version__)"
CHROMA_VERSION=1.5.9

# LLM used for answers. Leave these out to use Ollama on your PC (llama3.2).
# Only set LLM_BASE_URL for a hosted provider: it then works both inside and outside Docker.
# LLM_MODEL=llama3.2
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=llama-3.3-70b-versatile

# Optional stronger judge for evaluation (Phase 4):
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=your-key
# JUDGE_MODEL=llama-3.3-70b-versatile
